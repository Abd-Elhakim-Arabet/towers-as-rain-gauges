# Copy to .env and fill in. .env is never committed.

# data downloads (Phases 0-5)
OPENCELLID_TOKEN=
EARTHDATA_TOKEN=
KNMI_API_KEY=

# Phase 7 live watch: flood alarm emails
ALERT_TO=                 # who is warned; several addresses separated by commas
SMTP_HOST=                # the sending account, e.g. smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=            # for Gmail: an "app password", not the normal password
ALERT_FROM=               # optional; defaults to SMTP_USER
